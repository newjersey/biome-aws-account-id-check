engine biome(1.0)
language json

// Flags JSON string and number values that contain an exact 12-digit run,
// which is the format of an AWS account ID. Word boundaries on both sides of
// `\d{12}` keep 11-digit and 13-digit runs from matching, since a boundary
// requires a transition between a digit and a non-word character.
or {
  JsonStringValue() as $match,
  JsonNumberValue() as $match
} where {
  $match <: r".*\b\d{12}\b.*",
  register_diagnostic(span=$match, message="This value contains a 12-digit AWS account ID. Do not commit AWS account IDs to version control; load them from configuration or environment variables instead.", severity="warn")
}
