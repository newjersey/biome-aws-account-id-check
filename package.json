{
  "name": "biome-aws-account-id-check",
  "version": "0.1.0",
  "description": "Biome GritQL plugin that flags 12-digit AWS account IDs in JavaScript, TypeScript, JSON, and CSS source, with configurable warn or error severity.",
  "type": "module",
  "repository": "github:newjersey/biome-aws-account-id-check",
  "homepage": "https://github.com/newjersey/biome-aws-account-id-check",
  "bugs": "https://github.com/newjersey/biome-aws-account-id-check/issues",
  "files": [
    "plugins",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "node --test \"tests/**/*.test.ts\"",
    "prepare": "husky"
  },
  "keywords": [
    "biome",
    "biome-plugin",
    "gritql",
    "aws",
    "aws-account-id",
    "lint",
    "linter",
    "security"
  ],
  "author": {
    "name": "New Jersey Innovation Authority",
    "url": "https://github.com/newjersey"
  },
  "license": "MIT",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "husky": "9.1.7",
    "lint-staged": "17.3.0"
  },
  "lint-staged": {
    "*": "biome check --write --no-errors-on-unmatched"
  }
}
