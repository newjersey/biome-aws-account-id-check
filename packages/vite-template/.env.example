# Enable the feedback widget only after confirming the project is ready to transmit feedback.
VITE_FEEDBACK_WIDGET_ENABLED=false

# Required HTTPS support destination when the widget is enabled.
VITE_FEEDBACK_WIDGET_CONTACT_URL=https://www.nj.gov/nj/feedback.html

# Recommended privacy-preserving defaults.
VITE_FEEDBACK_WIDGET_ONLY_SAVE_RATING_TO_ANALYTICS=true
VITE_FEEDBACK_WIDGET_SHOW_COMMENT_DISCLAIMER=true
VITE_FEEDBACK_WIDGET_SKIP_EMAIL_STEP=true
