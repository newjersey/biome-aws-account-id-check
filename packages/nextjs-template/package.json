{
  "name": "@newjersey/nextjs-template",
  "version": "0.2.0",
  "description": "Next.js and Grove starter application",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm sync:grove-assets",
    "dev": "next dev",
    "prebuild": "pnpm sync:grove-assets",
    "build": "next build",
    "prestart": "pnpm sync:grove-assets",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:accessibility:install": "playwright install --with-deps chromium",
    "pretest:accessibility": "pnpm sync:grove-assets",
    "test:accessibility": "playwright test",
    "sync:grove-assets": "tsx scripts/syncGroveAssets.ts"
  },
  "dependencies": {
    "@newjersey/feedback-widget": "0.7.1",
    "@newjersey/njwds": "2.9.2",
    "@trussworks/react-uswds": "12.0.0",
    "@uswds/uswds": "3.14.0",
    "focus-trap-react": "11.0.4",
    "next": "16.3.3",
    "next-intl": "4.13.7",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "26.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "jsdom": "30.0.1",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
