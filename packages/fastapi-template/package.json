{
  "name": "@newjersey/fastapi-template",
  "version": "0.1.0",
  "description": "FastAPI and Python starter application",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "uv run --locked uvicorn fastapi_template.app:app --host 0.0.0.0 --port 3000 --reload",
    "build": "uv run --locked python scripts/build.py",
    "start": "uv run --locked python -m fastapi_template.server",
    "preview": "pnpm build && pnpm start",
    "typecheck": "uv run --locked ty check",
    "test": "uv run --locked pytest",
    "format": "uv run --locked ruff format .",
    "format:check": "uv run --locked ruff format --check .",
    "lint": "uv run --locked ruff check .",
    "lint:fix": "uv run --locked ruff check --fix .",
    "test:accessibility:install": "playwright install --with-deps chromium",
    "test:accessibility": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@types/node": "26.3.0",
    "typescript": "7.0.2"
  }
}
