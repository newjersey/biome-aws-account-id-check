{
  "name": "@newjersey/hono-template",
  "version": "0.1.0",
  "description": "Hono and TypeScript API starter application",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsx scripts/build.ts",
    "start": "node dist/server.mjs",
    "preview": "pnpm build && pnpm start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:accessibility:install": "playwright install --with-deps chromium",
    "test:accessibility": "playwright test"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "hono": "4.13.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@types/node": "26.3.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
