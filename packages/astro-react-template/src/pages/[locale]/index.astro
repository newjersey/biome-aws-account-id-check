---
import LandingPage from "@/src/components/LandingPage.astro";
import { DEFAULT_LOCALE, hasAppLocale } from "@/i18n/locales";
import { localeIndependentPathname } from "@/i18n/urls";

const localeParam = Astro.params.locale;

if (!localeParam || !hasAppLocale(localeParam)) {
  return Astro.rewrite("/404");
}

if (localeParam === DEFAULT_LOCALE) {
  return Astro.redirect("/", 301);
}

const locale = localeParam;
---

<LandingPage
  locale={locale}
  pathname={localeIndependentPathname(Astro.url.pathname)}
/>
