{
  "name": "@newjersey/astro-react-template",
  "version": "0.2.0",
  "description": "Astro, React Islands, Trussworks, and Grove server starter application",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm sync:grove-assets",
    "dev": "astro dev",
    "prebuild": "tsx scripts/cleanBuildOutput.ts && tsx scripts/syncGroveAssets.ts",
    "build": "astro build",
    "start": "node .amplify-hosting/compute/default/entry.mjs",
    "preview": "pnpm build && pnpm start",
    "typecheck": "tsc --noEmit --project tsconfig.typescript.json && astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:accessibility:install": "playwright install --with-deps chromium",
    "pretest:accessibility": "pnpm sync:grove-assets",
    "test:accessibility": "playwright test",
    "sync:grove-assets": "tsx scripts/syncGroveAssets.ts",
    "clean:build": "tsx scripts/cleanBuildOutput.ts"
  },
  "dependencies": {
    "@newjersey/feedback-widget": "0.7.1",
    "@newjersey/njwds": "2.9.2",
    "@astrojs/react": "6.0.4",
    "@trussworks/react-uswds": "12.0.0",
    "@uswds/uswds": "3.14.0",
    "astro": "7.2.7",
    "astro-aws-amplify": "0.6.0",
    "focus-trap-react": "11.0.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "jsdom": "30.0.1",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
