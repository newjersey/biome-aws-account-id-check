{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "paths": {
      "@/*": ["./*"]
    },
    "types": ["node"]
  },
  "include": [
    ".astro/types.d.ts",
    "astro.config.ts",
    "playwright.config.ts",
    "vitest.config.ts",
    "config/**/*.ts",
    "content/**/*.ts",
    "i18n/**/*.ts",
    "scripts/**/*.ts",
    "src/**/*.astro",
    "src/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["dist", "public"]
}
