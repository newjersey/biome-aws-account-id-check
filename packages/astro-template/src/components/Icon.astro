---
export interface Props {
  readonly class?: string;
  readonly name: "close" | "mail";
}

const { class: className, name } = Astro.props;
const iconClassName = className ? `usa-icon ${className}` : "usa-icon";
---

<svg aria-hidden="true" class={iconClassName} focusable="false">
  <use href={`/assets/grove/dist/img/sprite.svg#${name}`}></use>
</svg>
