---
import type { StarterFeature } from "@/content/messages/types";

export interface Props {
  readonly features: readonly StarterFeature[];
  readonly label: string;
}

const { features, label } = Astro.props;
const rows = [features.slice(0, 2), features.slice(2, 4)];
---

<section
  aria-label={label}
  class="usa-graphic-list usa-section usa-section--dark"
>
  <div class="grid-container">
    {
      rows.map((row) => (
        <div class="usa-graphic-list__row grid-row grid-gap">
          {row.map((feature) => (
            <div class="usa-media-block tablet:grid-col">
              <img
                alt=""
                class="usa-media-block__img"
                height="124"
                src="/assets/grove/dist/img/circle-124.png"
                width="124"
              />
              <div class="usa-media-block__body">
                <h3 class="usa-graphic-list__heading">{feature.title}</h3>
                <p>{feature.description}</p>
              </div>
            </div>
          ))}
        </div>
      ))
    }
  </div>
</section>
