---
import { GROVE_DOCUMENTATION_HREF } from "@/config/externalLinks";
import type { HomeMessages } from "@/content/messages/types";

export interface Props {
  readonly content: HomeMessages;
}

const { content } = Astro.props;
---

<section aria-labelledby="hero-heading" class="usa-hero">
  <div class="grid-container">
    <div class="usa-hero__callout">
      <h1 class="usa-hero__heading" id="hero-heading">
        <span class="usa-hero__heading--alt">{content.heroHeadingLead}</span>
        {" "}
        {content.heading}
      </h1>
      <p>{content.introduction}</p>
      <a class="usa-button" href={GROVE_DOCUMENTATION_HREF}>
        {content.primaryActionLabel}
      </a>
    </div>
  </div>
</section>
