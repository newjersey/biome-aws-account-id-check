---
import { GROVE_DOCUMENTATION_HREF } from "@/config/externalLinks";
import type { FooterMessages, NavigationItem, SocialLink } from "@/content/messages/types";

export interface Props {
  readonly content: FooterMessages;
}

const { content } = Astro.props;
const navigationItems: readonly NavigationItem[] = [
  { label: content.foundationLabel, href: "#features" },
  { label: content.nextStepsLabel, href: "#next-steps" },
  { label: content.groveDocumentationLabel, href: GROVE_DOCUMENTATION_HREF },
];
const socialLinks: readonly SocialLink[] = [
  {
    label: content.githubLabel,
    href: "https://github.com/newjersey",
    iconPath: "/assets/grove/dist/img/usa-icons/github.svg",
  },
  {
    label: content.storybookLabel,
    href: "https://storybook.grove.nj.gov/",
    iconPath: "/assets/grove/dist/img/usa-icons/launch.svg",
  },
];
---

<footer class="usa-footer">
  <div class="grid-container usa-footer__return-to-top">
    <a data-focus-target="top" href="#top">{content.returnToTopLabel}</a>
  </div>
  <div class="usa-footer__primary-section">
    <div class="grid-container">
      <nav aria-label={content.navigationLabel} class="usa-footer__nav">
        <ul class="grid-row grid-gap">
          {
            navigationItems.map((item) => (
              <li class="mobile-lg:grid-col-4 desktop:grid-col-auto usa-footer__primary-content">
                <a class="usa-footer__primary-link" href={item.href}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>
  <div class="usa-footer__secondary-section">
    <div class="grid-container">
      <div class="grid-row grid-gap">
        <div class="usa-footer__logo grid-row mobile-lg:grid-col-6 mobile-lg:grid-gap-2">
          <div class="mobile-lg:grid-col-auto">
            <img
              alt=""
              class="usa-footer__logo-img height-auto"
              height="140"
              src="/assets/grove/dist/img/logo-img.png"
              width="140"
            />
          </div>
          <div class="mobile-lg:grid-col-auto">
            <h3 class="usa-footer__logo-heading">{content.agencyName}</h3>
          </div>
        </div>
        <div class="usa-footer__contact-links mobile-lg:grid-col-6">
          <div class="usa-footer__social-links grid-row grid-gap-1">
            {
              socialLinks.map((item) => (
                <div class="grid-col-auto">
                  <a class="usa-social-link" href={item.href}>
                    <img
                      alt={item.label}
                      class="usa-social-link__icon"
                      height="24"
                      src={item.iconPath}
                      width="24"
                    />
                  </a>
                </div>
              ))
            }
          </div>
          <h3 class="usa-footer__contact-heading">{content.contactHeading}</h3>
          <address class="usa-footer__address">
            <div class="usa-footer__contact-info grid-row grid-gap">
              <div class="grid-col-auto">
                <a href="https://innovation.nj.gov/">{content.contactWebsiteLabel}</a>
              </div>
              <div class="grid-col-auto">
                <a href="mailto:team@innovation.nj.gov">{content.contactEmailLabel}</a>
              </div>
            </div>
          </address>
        </div>
      </div>
    </div>
  </div>
</footer>
