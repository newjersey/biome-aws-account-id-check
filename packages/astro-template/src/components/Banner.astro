---
import type { ShellMessages } from "@/content/messages/types";
import type { TextDirection } from "@/i18n/locales";
import Icon from "@/src/components/Icon.astro";

export interface Props {
  readonly content: ShellMessages;
  readonly direction: TextDirection;
}

const { content, direction } = Astro.props;
const sealClassName =
  direction === "rtl"
    ? "nj-banner__header-seal height-auto padding-left-1 padding-right-0"
    : "nj-banner__header-seal height-auto";
const iconSpacingClassName =
  direction === "rtl"
    ? "usa-icon--size-3 nj-banner__mail-icon margin-left-05"
    : "usa-icon--size-3 nj-banner__mail-icon margin-right-05";
---

<section aria-label={content.officialSiteBannerLabel} class="nj-banner">
  <div class="nj-banner__header">
    <div class="grid-container">
      <div class="nj-banner__inner">
        <div class="grid-col-auto display-flex flex-align-center">
          <img
            alt={content.stateSealAlt}
            class={sealClassName}
            height="30"
            src="/assets/grove/dist/img/nj_state_seal.png"
            width="30"
          />
        </div>
        <div class="grid-col-fill display-flex flex-align-center">
          <a
            class="display-flex flex-align-center line-height-sans-2 minh-4"
            href="https://www.nj.gov/"
            rel="noopener"
          >
            {content.officialSiteLabel}
          </a>
        </div>
        <ul class="grid-col-auto display-flex flex-align-center usa-list--unstyled">
          <li class="display-flex flex-align-center">
            <a
              class="display-flex flex-align-center line-height-sans-2 minh-4"
              href="https://www.nj.gov/governor/"
              rel="noopener"
            >
              {content.governorLabel}
            </a>
          </li>
          <li class="grid-col-auto display-flex flex-align-center">
            <a
              class="display-flex flex-align-center line-height-sans-2 minh-4"
              href="https://www.nj.gov/subscribe/"
              rel="noopener"
            >
              <Icon class={iconSpacingClassName} name="mail" />
              {content.updatesLabel}
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>
