{
  "name": "@newjersey/astro-template",
  "version": "0.2.0",
  "description": "Astro and Grove starter application",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm sync:grove-assets",
    "dev": "astro dev",
    "prebuild": "pnpm sync:grove-assets",
    "build": "astro build",
    "prestart": "pnpm sync:grove-assets",
    "start": "vite preview --host 0.0.0.0 --port 3000",
    "preview": "vite preview --port 3000",
    "typecheck": "tsc --noEmit --project tsconfig.typescript.json && astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:accessibility:install": "playwright install --with-deps chromium",
    "pretest:accessibility": "pnpm sync:grove-assets",
    "test:accessibility": "playwright test",
    "sync:grove-assets": "tsx scripts/syncGroveAssets.ts"
  },
  "dependencies": {
    "@newjersey/feedback-widget": "0.7.1",
    "@newjersey/njwds": "2.9.2",
    "astro": "7.2.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.3.0",
    "jsdom": "30.0.1",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
