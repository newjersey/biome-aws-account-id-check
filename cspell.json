{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en",
  "ignorePaths": [
    "node_modules",
    "pnpm-lock.yaml",
    "**/.gitignore",
    "**/.next",
    "**/.astro",
    "**/dist",
    "**/dist-playwright",
    "**/public/assets/grove",
    "**/test-results",
    "**/playwright-report",
    "**/coverage",
    "packages/*/content/messages/ar-SA/**",
    "packages/*/content/messages/es-US/**",
    "packages/*/content/messages/fr-FR/**",
    "packages/*/content/messages/it-IT/**",
    "packages/*/content/messages/ru-RU/**",
    "packages/*/content/messages/zh-CN/**"
  ],
  "words": [
    "Amplify",
    "Astro",
    "axe",
    "biomejs",
    "Biome",
    "Deque",
    "Grove",
    "hreflang",
    "intl",
    "jsdom",
    "loong",
    "nextjs",
    "njwds",
    "pnpm",
    "riscv",
    "tsdk",
    "tsgo",
    "tsx",
    "Trussworks",
    "Vite",
    "Vitest"
  ]
}
